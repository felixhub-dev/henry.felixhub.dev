{
    "$id": "photos.schema.json",
    "title": "Photos Images Schema",
    "description": "Schema for the /api/photos.json file",
    "type": "object",
    "properties": {
        "$schema":  {
            "type": "string",
            "format": "file"
        },
        "photos": {
            "type": "array",
            "minItems": 1,
            "items": {
                "type": "object",
                "properties": {
                    "file": {
                        "type": "string",
                        "format": "file"
                    },
                    "location": {
                        "type": "string"
                    },
                    "date": {
                        "type": "string",
                        "format": "date-time"
                    },
                    "id": {
                        "type": "string",
                        "format": "id"
                    },
                    "name": {
                        "type": "string"
                    }
                },
                "required": ["file", "id", "name"]
            },
            "description": "List of photos"
        }
    }
}